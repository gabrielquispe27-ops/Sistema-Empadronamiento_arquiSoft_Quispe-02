{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "quispe/sistema-empadronamiento-emergencia",
    "type": "project",
    "description": "Sistema Transaccional de Respuesta Rápida para el Empadronamiento en Zonas de Emergencia (Laravel 11).",
    "keywords": [
        "laravel",
        "empadronamiento",
        "defensa-civil",
        "redis",
        "queues",
        "sanctum",
        "clean-architecture"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "darkaonline/l5-swagger": "^8.6",
        "laravel/framework": "^11.0",
        "laravel/octane": "^2.23",
        "laravel/sanctum": "^4.0",
        "predis/predis": "^2.2",
        "spiral/roadrunner-cli": "^3.1",
        "spiral/roadrunner-http": "^4.2"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.0",
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ],
        "test": [
            "@php artisan test"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
